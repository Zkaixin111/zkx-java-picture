# 根目录忽略规则（子项目内已有各自 .gitignore 的规则继续生效）

# IDE
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# 系统文件
.DS_Store
Thumbs.db

# 日志
*.log
logs/

# Maven 构建产物
target/

# Node 依赖与构建产物
node_modules/
dist/
dist-ssr/

# ============ 敏感配置（绝不提交）============
# 包含真实密钥的配置文件
application.yml
application-*.yml
*.env
.env.*
!application-template.yml

# HTTP 客户端环境变量（含真实 cookie/token）
http-client.env.json
__MACOSX/

# 阿里云 AI API key（防止在 Java 代码中硬编码残留）
# 腾讯云 COS 密钥
*.pem
*.p12
*.jks
*.keystore
*.key

# 本地环境配置
*.local
.env.local
.env.*.local

# 临时文件
*.tmp
*.bak
.workbuddy/
.trae-html-share-packages/
interview-prep/

# 教程/学习资料（不属于项目运行产物）
docs/
WebSocket实时模块讲解.md
简历参考.md
